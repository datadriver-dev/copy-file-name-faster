{
  "name": "copy-file-name-faster",
  "displayName": "Copy File Name (Faster)",
  "description": "Copy just a file or folder name from the VS Code Explorer or editor-tab menu, including compatible browser-hosted VS Code IDEs.",
  "publisher": "PawanP1",
  "version": "0.0.7",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/datadriver-dev/copy-file-name-faster.git"
  },
  "engines": {
    "vscode": "^1.89.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-file-name-faster.copyFileName",
        "title": "Copy File Name"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copy-file-name-faster.copyFileName",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "copy-file-name-faster.copyFileName",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-web",
    "compile-web": "npm run check-types && npm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/vscode": "1.89.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
